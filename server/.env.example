# Copy this file to server/.env and fill in your values. server/.env is git-ignored.

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Include the database name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/jarvis-crm?retryWrites=true&w=majority

# Port the Express server listens on. The Vite dev server proxies /api here.
PORT=3001
